# syntax=docker/dockerfile:1.7
ARG STACK
FROM python:3.12-slim

ARG STACK
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY ${STACK}/orchestrator/src/requirements.txt ./requirements.txt
COPY --from=cql_sdk /pyproject.toml /README.md /LICENSE /tmp/cql-sdk/
COPY --from=cql_sdk /src /tmp/cql-sdk/src
COPY --from=cql_sdk /tests/fixtures/valuesets /tmp/cql-sdk/tests/fixtures/valuesets
RUN pip install --no-cache-dir "/tmp/cql-sdk[postgres]" \
    && pip install --no-cache-dir -r requirements.txt \
    && rm -rf /tmp/cql-sdk

COPY ${STACK}/orchestrator/src/*.py ./
COPY ${STACK}/orchestrator/src/memory/ ./memory/
COPY _measures/ ./measures/

RUN useradd -m -u 1000 mcpuser \
    && chown -R mcpuser:mcpuser /app

USER mcpuser
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "digital_quality_orchestrator:app", "--host", "0.0.0.0", "--port", "8000"]
