table MeasureReports
	lineageTag: measure-reports

	/// Unweighted average of persisted report-level performance rates. Prefer Weighted reported rate for aggregated analysis within a measure.
	measure 'Performance rate' = AVERAGE('MeasureReports'[PerformanceRate])
		formatString: 0.0%
		displayFolder: Measure Performance
		lineageTag: 4b45a576-29ca-42cc-8c7e-53878235f5c4

	/// Distinct measure reports received by the receiver in the current filter context.
	measure 'Measure reports' = DISTINCTCOUNT('MeasureReports'[MeasureReportId])
		formatString: #,##0
		displayFolder: Measure Performance
		lineageTag: ef934365-a285-4ee0-bd1b-65bac44902fd

	/// Sum of reported numerator populations. Interpret within a selected measure because population semantics differ by measure.
	measure 'Total numerator' = SUM('MeasureReports'[Numerator])
		formatString: #,##0
		displayFolder: Measure Performance
		lineageTag: 1218538b-62fc-42b2-93d1-bc3d3f0f49f1

	/// Sum of reported denominator populations. Interpret within a selected measure because population semantics differ by measure.
	measure 'Total denominator' = SUM('MeasureReports'[Denominator])
		formatString: #,##0
		displayFolder: Measure Performance
		lineageTag: 7a20daa3-abbf-461a-8680-921f7602b14f

	/// Sum of reported denominator exclusions.
	measure 'Total exclusions' = SUM('MeasureReports'[Exclusions])
		formatString: #,##0
		displayFolder: Measure Performance
		lineageTag: d2553a77-52e6-43fc-9573-85ce626b9f64

	/// Reported exclusions divided by the reported denominator in the current filter context.
	measure 'Exclusion rate' =
			DIVIDE(
			    [Total exclusions],
			    [Total denominator]
			)
		formatString: 0.0%
		displayFolder: Measure Performance
		lineageTag: 40e6ea3c-5302-4836-bf6f-3f198bdcd41a

	/// Denominator-weighted reported performance rate. Compare within one measure; do not interpret as a cross-measure composite score.
	measure 'Weighted reported rate' =
			DIVIDE(
			    [Total numerator],
			    [Total denominator]
			)
		formatString: 0.0%
		displayFolder: Measure Performance
		lineageTag: a38cbe1c-bec2-4992-9791-530d13af979f

	/// Measure reports whose denominator is blank or zero and therefore cannot produce a meaningful reported rate.
	measure 'Reports with missing denominator' =
			CALCULATE(
			    [Measure reports],
			    KEEPFILTERS(
			        ISBLANK('MeasureReports'[Denominator])
			            || 'MeasureReports'[Denominator] = 0
			    )
			)
		formatString: #,##0
		displayFolder: Data Quality
		lineageTag: 0b5a159d-065a-4221-930b-91a7af5dc260

	column MeasureReportId
