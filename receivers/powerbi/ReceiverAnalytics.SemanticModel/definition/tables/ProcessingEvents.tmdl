	/// Identifier that links processing events to the originating submission or workbench execution.
	column CorrelationId
		dataType: string
		lineageTag: 25068fd6-18ea-49b0-9d4d-8226bf1b6935
		summarizeBy: none
		sourceColumn: CorrelationId

	/// Quality measure associated with the processing event.
	column MeasureId
		dataType: string
		lineageTag: 757b2019-299a-49df-9a64-ae285a49fa98
		summarizeBy: none
		sourceColumn: MeasureId

	/// Organization associated with the processing event.
	column SubmitterId
		dataType: string
		lineageTag: cda786b3-1775-4f49-b776-6ab339590ce1
		summarizeBy: none
		sourceColumn: SubmitterId

	/// Reporting program associated with the processing event.
	column ProgramId
		dataType: string
		lineageTag: 59ab5bee-8e70-471e-a4b5-a3fa10c6b22c
		summarizeBy: none
		sourceColumn: ProgramId

	/// Elapsed processing time in milliseconds when captured by the receiver.
	column LatencyMs
		dataType: int64
		lineageTag: 4f0d586c-d96d-4307-82b2-fd0725dc6860
		summarizeBy: none
		sourceColumn: LatencyMs

	/// Machine-readable error classification for a failed processing event.
	column ErrorCode
		dataType: string
		lineageTag: 30337006-a046-4f73-8900-b69f31b54b58
		summarizeBy: none
		sourceColumn: ErrorCode

