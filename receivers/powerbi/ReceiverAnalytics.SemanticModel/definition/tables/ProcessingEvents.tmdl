table ProcessingEvents
	lineageTag: processing-events

	/// Share of receiver processing events that completed successfully.
	measure 'Processing success rate' =
			DIVIDE(
			    SUM('ProcessingEvents'[SucceededCount]),
			    SUM('ProcessingEvents'[TotalCount])
			)
		formatString: 0.0%
		displayFolder: Operations
		lineageTag: 311e9063-bd0c-4850-af3a-bd56e7ff85a3

	/// Number of receiver processing events in the current filter context.
	measure 'Processing events' = SUM('ProcessingEvents'[TotalCount])
		formatString: #,##0
		displayFolder: Operations
		lineageTag: 16d31659-7ec9-49e7-9f4d-a0d830ca060c

	/// Number of receiver processing events that completed successfully.
	measure 'Successful processing events' = SUM('ProcessingEvents'[SucceededCount])
		formatString: #,##0
		displayFolder: Operations
		lineageTag: 18b5bf09-39d9-448e-aa1d-9f850bd5ef88

	/// Number of receiver processing events that did not complete successfully.
	measure 'Failed processing events' = [Processing events] - [Successful processing events]
		formatString: #,##0
		displayFolder: Operations
		lineageTag: 3c82f8fd-4fe0-4d41-86d4-8ba4b9826961

	/// Failed validation events recorded by the receiver.
	measure 'Validation errors' =
			CALCULATE(
			    [Failed processing events],
			    KEEPFILTERS('ProcessingEvents'[EventType] = "Validation")
			)
		formatString: #,##0
		displayFolder: Operations
		lineageTag: dddc5752-2a90-4120-a4aa-2bfd5e2134d1

	/// Average elapsed processing time for events with captured latency.
	measure 'Average latency' = AVERAGE('ProcessingEvents'[LatencyMs])
		formatString: #,##0 "ms"
		displayFolder: Operations\Latency
		lineageTag: 17b7e226-2d48-4838-a875-9d8f1f8cf457

	/// Median elapsed processing time for events with captured latency.
	measure 'Median latency' = MEDIAN('ProcessingEvents'[LatencyMs])
		formatString: #,##0 "ms"
		displayFolder: Operations\Latency
		lineageTag: ec906e40-579c-484b-aa34-30913a1d2821

	/// 95th percentile elapsed processing time for events with captured latency.
	measure 'P95 latency' =
			PERCENTILEX.INC(
			    FILTER(
			        'ProcessingEvents',
			        NOT ISBLANK('ProcessingEvents'[LatencyMs])
			    ),
			    'ProcessingEvents'[LatencyMs],
			    0.95
			)
		formatString: #,##0 "ms"
		displayFolder: Operations\Latency
		lineageTag: ee1b72a9-a76a-46ed-b173-470519c53bac

	column ProcessingEventId
		dataType: int64
		lineageTag: 8b4d9c9b-0a4a-4013-9046-36e6d5bad635
		sourceColumn: ProcessingEventId

	column CreatedAtUtc
		dataType: dateTime
		lineageTag: a5bf5ea0-ec6b-49d4-b7b2-39b0ae5071fd
		sourceColumn: CreatedAtUtc

	column EventType
		dataType: string
		lineageTag: d40b7acd-b395-4392-b87f-5de59e2a69e8
		sourceColumn: EventType

	column Status
		dataType: string
		lineageTag: 7211c2d1-182d-40b9-a5b1-f018ebe24a62
